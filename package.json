{
  "name": "conceptualware-root",
  "version": "1.0.0",
  "private": true,
  "description": "Orquestração de tooling de DevOps local (Husky/lint-staged) para o monorepo gateway+frontend.",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7"
  },
  "lint-staged": {
    "gateway/**/*.ts": [
      "bash -c 'cd gateway && npx eslint --fix'"
    ],
    "frontend/**/*.{ts,tsx}": [
      "bash -c 'cd frontend && npx eslint --fix'"
    ]
  }
}
